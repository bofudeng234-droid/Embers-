# 复制为 .env 并填入实际 key

# ============ Embedding 层(向量化 — 项目核心) ============
EMBEDDING_PROVIDER=zhipu
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=2048

# OpenAI 备选
OPENAI_API_KEY=

# ============ VLM 层(多帧场景描述 — v0.2) ============
# 默认走 zhipu(用同一个 ZHIPU_API_KEY,无需再填)
VLM_PROVIDER=zhipu
# VLM_MODEL=glm-4v-flash    # 不设用默认

# ============ CLIP 本地视觉编码(真多模态 — v0.3) ============
# 图片 + 文字进同一个 512d 向量空间(Chinese-CLIP),实现真跨模态检索
CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
CLIP_DEVICE=cpu             # cpu(默认,最稳)/ mps(Apple Silicon 加速)/ cuda
CLIP_DIM=512                # base=512 / large=768 / huge=1024,要跟 CLIP_MODEL 对应

# ============ CLAP 本地音频编码(三路 — v0.4) ============
# 音频(音乐 / 语音 / 音效)+ 文字进同一个 512d 向量空间(LAION-CLAP)
CLAP_MODEL=laion/clap-htsat-unfused
CLAP_DEVICE=cpu
CLAP_DIM=512

# ============ Whisper 转写(本地,无 API key) ============
WHISPER_MODEL_SIZE=small    # tiny / base / small(推荐)/ medium / large
WHISPER_DEVICE=auto         # auto / cpu / cuda
WHISPER_COMPUTE=auto        # auto / int8 / float16
WHISPER_LANGUAGE=zh

# ============ LLM 层(rerank · 可选,默认关闭) ============
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# LLM_MODEL=

# ============ yt-dlp 视频下载 ============
# 抖音要求浏览器 cookies。yt-dlp 直接从你装的浏览器读取(无需登录,访问过 douyin.com 即可)
YT_DLP_BROWSER=chrome    # chrome / safari / firefox / edge
# YT_DLP_COOKIES_FILE=./data/cookies.txt   # 备选:导出的 cookies.txt 路径

# ============ Database ============
EMBERS_DB_PATH=./data/embers.db
