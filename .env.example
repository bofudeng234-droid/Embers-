# 复制为 .env 并填入实际 key

# ============ Embedding 层(向量化 — 项目核心) ============
# 可选: zhipu(推荐,智谱 GLM 中文强)/ openai
EMBEDDING_PROVIDER=zhipu

# 智谱 GLM embedding-3,2048 维(推荐)
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3

# 注:provider 切换需同步改 EMBEDDING_DIM,且删除旧 .db(sqlite-vec 表 schema 固定 dim)
#   zhipu  embedding-3:    EMBEDDING_DIM=2048
#   openai text-embedding-3-small: EMBEDDING_DIM=1536
EMBEDDING_DIM=2048

# OpenAI 备选(默认不用)
OPENAI_API_KEY=


# ============ LLM 层(rerank — 可选,默认关闭) ============
# 可选: deepseek(推荐)/ kimi / zhipu / openai
LLM_PROVIDER=deepseek

# DeepSeek V4 chat(推荐 · 中文强 · 便宜)
DEEPSEEK_API_KEY=

# Kimi (Moonshot) 备选
MOONSHOT_API_KEY=

# 不设 LLM_MODEL 则用 provider 默认
# deepseek → deepseek-chat
# kimi → moonshot-v1-8k
# zhipu → glm-4-flash
# openai → gpt-4o-mini
# LLM_MODEL=


# ============ Database ============
EMBERS_DB_PATH=./data/embers.db
